#!/bin/bash
source {{ telegram_env_path }}
MARKER="/tmp/audit-watchdog-last"

LAST=$(cat "$MARKER" 2>/dev/null || echo "5 minutes ago")
EVENTS=$(ausearch -k xray_config -k xray_binary --start "$LAST" 2>/dev/null | grep -c "type=SYSCALL")

if [ "$EVENTS" -gt 0 ]; then
    curl -s --resolve api.telegram.org:443:149.154.167.220 \
        -X POST "https://api.telegram.org/bot${F2B_BOT_TOKEN}/sendMessage" \
        -d chat_id="${F2B_CHAT_ID}" \
        -d text="🔍 <b>{{ inventory_hostname | upper }}</b>: ${EVENTS} audit events on XRay files" \
        -d parse_mode=HTML > /dev/null 2>&1
fi

date "+%m/%d/%Y %H:%M:%S" > "$MARKER"
